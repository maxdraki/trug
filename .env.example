# Copy to .env and fill in as needed: `cp .env.example .env`
# Every value here is optional and commented out below, so an unedited
# `cp .env.example .env` is inert — the image's built-in defaults apply.
# Uncomment a line (and set/keep the value) to pin it.

# --- Household & domain (set these for a real deployment) ---
# There is NO household roster in the environment. TRUG_USERS is RETIRED and, if
# still set, is simply ignored (it won't error). The household is a dynamic roster
# in the database: the FIRST person claims the instance with the bootstrap token
# below, then anyone already in can invite the rest from Settings → Members by
# name — no fixed list, no per-user tokens.
#
# Passkeys (WebAuthn) bind credentials to your domain, so RP_ID and ORIGIN are
# REQUIRED once you serve Trug on a real hostname. The defaults below work for a
# local try on http://localhost:8000 with no changes.
# HTTPS (or literal localhost) is a PREREQUISITE for creating accounts, not a
# nice-to-have: a browser won't create a passkey in an insecure context and
# RP_ID can't be an IP, so a human can't claim an account over http://<ip>:8000.
# Give the box a trusted HTTPS name first (Tailscale Serve or a Cloudflare Tunnel).
# TRUG_RP_ID=trug.example.com            # bare host — no scheme, no port
# TRUG_ORIGIN=https://trug.example.com   # full origin people actually visit
# TRUG_SESSION_DAYS=60                   # passkey session lifetime (default shown)

# In-process rate limiter on the auth endpoints (bootstrap/login/register/token).
# On by default; set to false if a reverse proxy already limits (see README).
# TRUG_RATE_LIMIT_ENABLED=true
# Trusted reverse-proxy hops in front of Trug, used to pick the real client IP.
# 0 (default) = directly exposed / dev: X-Forwarded-For is ignored, socket peer
# is used. 1 = behind one reverse proxy (Cloudflare/nginx/Tailscale); use N for N
# chained proxies. A proxied deployment MUST set this, or every client shares one
# bucket. An edge limiter is still recommended regardless.
# TRUG_TRUSTED_PROXY_HOPS=0

# --- First-user bootstrap token ---
# TRUG_BOOTSTRAP_TOKEN claims the very FIRST account on a fresh instance: open the
# app, choose "use an access token", paste this, then create the first account
# (name + passkey). It is one-time and first-user-only — it stops working the
# moment the first account is claimed, and is ignored once any user exists.
# Leave it unset to have trug generate one and PRINT IT IN THE BOOT BANNER (only
# while no account exists yet). Pin it if you want a stable value before the first
# claim (e.g. across restarts on a fresh deploy).
# TRUG_BOOTSTRAP_TOKEN=

# --- Machine tokens (unchanged) ---
# RING/MCP are the only env-configured bearers: the voice-ring webhook and the
# token-based MCP surface. Any you don't pin here is regenerated on EVERY restart
# (and reprinted in the boot banner), so PIN THESE so a restart doesn't log those
# clients out. Pinning one never deletes the other.
# TRUG_TOKEN_RING=   # machine key for the ring (voice) webhook
# TRUG_TOKEN_MCP=    # machine key for token-based MCP / automation clients

# --- Storage & assets (sensible defaults baked into the image) ---
# TRUG_DB_PATH=/data/trug.db      # SQLite path inside the container (default shown)
# TRUG_STATIC_DIR=/app/static     # built PWA directory (default shown)

# --- LLM enrichment (optional; item icons/categories work without it) ---
# These are the DEFAULT config, applied at startup. A signed-in human can
# override them at runtime in Settings → AI enrichment (pick a provider, add a
# key, test, save) with no redeploy; the stored config takes precedence over
# everything below. Clearing it in Settings reverts to these env values.
# LLM_API_KEY=                    # API key for the LLM provider
# LLM_MODEL=claude-haiku-4-5      # model id (default shown)
# LLM_BASE_URL: point at an OpenAI-COMPATIBLE endpoint. Setting this switches the
# wire protocol, not just the host — any non-empty value makes Trug POST
# OpenAI-shaped bodies to {base_url}/chat/completions with a Bearer token, instead
# of Anthropic's x-api-key + Messages API. The endpoint must speak the OpenAI
# protocol; an Anthropic-format proxy will fail.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # e.g. Gemini

# TRUG_SECRET: when set, the api key a human saves in Settings → AI enrichment is
# encrypted at rest (Fernet, key derived from this secret) in the SQLite DB.
# Without it the saved key is stored in plaintext in the DB file — fine for a
# single-household self-host, but set this if the DB may be backed up or shared.
# Use a long random value and keep it stable (rotating it makes existing saved
# keys unreadable). Does NOT affect LLM_API_KEY above, which lives in the env.
# TRUG_SECRET=

# --- Optional: expose Trug via a Cloudflare Tunnel ---
# Uncomment the cloudflared service in docker-compose.yml, then drop your tunnel
# token here (point the tunnel at http://trug:8000 in the Cloudflare dashboard).
# CLOUDFLARE_TUNNEL_TOKEN=
